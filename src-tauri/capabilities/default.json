{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Music Island windows.",
  "windows": ["main", "settings", "already-running", "intro"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "opener:default",
    "autostart:default",
    "log:default",
    "updater:default"
  ]
}