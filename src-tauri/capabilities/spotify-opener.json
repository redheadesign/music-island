{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "spotify-opener",
  "description": "Allows the Settings window to launch the installed Spotify client.",
  "windows": ["settings"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "spotify:*" }
      ]
    }
  ]
}
