{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Island",
  "version": "0.9.8",
  "identifier": "com.redheadesign.music-island",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Music Island",
        "width": 220,
        "height": 20,
        "minWidth": 120,
        "minHeight": 8,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "x": 0,
        "y": 0
      },
      {
        "label": "settings",
        "title": "Music Island Settings",
        "width": 860,
        "height": 720,
        "minWidth": 620,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "publisher": "Fedor Svetlov",
    "category": "Utility",
    "shortDescription": "Low-distraction top-edge media controller for Windows.",
    "longDescription": "Music Island controls Windows media sessions through SMTC and offers an explicit opt-in direct connection to Yandex Music Desktop.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "sidebarImage": null
      }
    }
  }
}
