{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Island",
  "version": "3.0.0",
  "identifier": "com.redheadesign.music-island",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/Music Island/dictation/recordings/**"] }
    },
    "windows": [
      {
        "label": "main",
        "title": "Music Island",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "x": 0,
        "y": 0
      },
      {
        "label": "settings",
        "dragDropEnabled": false,
        "title": "Music Island Settings",
        "width": 860,
        "height": 720,
        "minWidth": 620,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      },
      {
        "label": "already-running",
        "title": "Music Island",
        "width": 380,
        "height": 220,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      },
      {
        "label": "intro",
        "title": "Music Island",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "publisher": "Fedor Svetlov",
    "category": "Utility",
    "shortDescription": "Music controls and local voice typing for Windows.",
    "longDescription": "Control music from the top edge of your Windows desktop and type with your voice in the active application. Optional local dictation is based on Handy.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "sidebarImage": null
      }
    }
  }
}
